{
  "appId": "com.tripcustomizer.app",
  "appName": "Trip Customizer",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://www.tripcustomizer.com",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0066ff",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0066ff"
    }
  }
}
